# Variables para el stack de producción (docker-compose.prod.yml).
# Copia a .env (gitignored) o expórtalas antes de `docker compose -f docker-compose.prod.yml up`.

# Origen público real (tu dominio). El backend solo acepta peticiones CORS de este origen.
PUBLIC_ORIGIN=https://pdf.tudominio.com

# Opcional. Clave de Google Gemini para el buscador con IA. Si se deja vacía, el
# frontend usa la búsqueda local y no se llama a ningún servicio externo.
GEMINI_API_KEY=
