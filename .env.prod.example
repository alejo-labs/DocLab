# Variables para el stack de producción (docker-compose.prod.yml).
# Copia a .env (gitignored) o expórtalas antes de `docker compose -f docker-compose.prod.yml up`.

# Origen público real. El backend solo aceptará peticiones CORS de este origen.
PUBLIC_ORIGIN=https://pdf.tudominio.com

# Tamaño máximo de archivo para conversión de Office (MB).
MAX_FILE_SIZE_MB=50
