# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Entorno: development | test | production
NODE_ENV=development

# Puerto del backend.
PORT=4000

# Orígenes permitidos para CORS, separados por coma.
# En producción usa tu dominio real, por ejemplo https://doclab-pdf.com
CORS_ORIGINS=http://localhost:5174

# Rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Timeout de petición (ms).
REQUEST_TIMEOUT_MS=60000

# Buscador con IA (Google Gemini). OPCIONAL. Sin clave, el buscador con IA se
# desactiva y el frontend usa solo la búsqueda local. Consigue la clave en
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
