# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.

# Entorno: development | test | production
NODE_ENV=development

# Puerto del backend (aislado del ERP que usa 3001).
PORT=4000

# URL interna de Gotenberg. En desarrollo apunta al puerto publicado por Docker.
# En producción/red interna usa el nombre de servicio: http://gotenberg:3000
GOTENBERG_URL=http://localhost:8081

# Orígenes permitidos para CORS, separados por coma.
# En producción usa tu dominio real, p.ej: https://pdf.tudominio.com
CORS_ORIGINS=http://localhost:5174

# Tamaño máximo de archivo subido (MB).
MAX_FILE_SIZE_MB=50

# Rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Timeout de petición (ms). Las conversiones de Office pueden tardar.
REQUEST_TIMEOUT_MS=60000

# Buscador con IA (Google Gemini). OPCIONAL: sin clave, el buscador IA se
# desactiva y el frontend usa solo la búsqueda local. Obtén la clave en
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
